# Wun Digital — lead capture environment variables
# Copy to .env.local and fill in. All are optional in development:
# missing values are logged and the form still returns success.

# CRM / Zapier / Make webhook that receives each lead as JSON (POST).
LEAD_WEBHOOK_URL=

# Resend API key for the internal "new lead" notification email.
RESEND_API_KEY=

# Where lead notification emails are sent.
LEAD_NOTIFY_EMAIL=

# Verified Resend sender address (defaults to leads@wundigital.co.uk).
LEAD_FROM_EMAIL=
